<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_background" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#5A000000" />

    <LinearLayout
        android:id="@+id/start_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/project_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/project_pas"
            android:textColor="@android:color/white"
            android:textSize="42sp" />

        <TextView
            android:id="@+id/touch_to_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/touch_to_start"
            android:textColor="#EBD9AD"
            android:textSize="19sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_skin_shop" android:layout_width="180dp" android:layout_height="48dp" android:layout_marginTop="24dp" android:background="@drawable/bg_continent_button" android:backgroundTint="@null" android:text="스킨 상점" android:textColor="#F3D99A" android:textSize="15sp"/>
    </LinearLayout>
</FrameLayout>
